<mei xml:id="mei-1" xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead xml:id="meiHead-1">
      <fileDesc xml:id="fileDesc-1">
         <titleStmt xml:id="titleStmt-1">
            <title xml:id="title-1"></title>
         </titleStmt>
         <pubStmt xml:id="pubStmt-1">
            <availability xml:id="availability-1">
               <useRestrict xml:id="useRestrict-1">CC-BY-4.0</useRestrict>
            </availability>
         </pubStmt>
      </fileDesc>
      <encodingDesc xml:id="encodingDesc-1">
         <appInfo xml:id="appInfo-1">
            <application version="1" xml:id="lets-encode">
               <name xml:id="name-1">Let's Encode!</name>
            </application>
         </appInfo>
      </encodingDesc>
      <revisionDesc xml:id="revisionDesc-1">
         <change xml:id="change-1" n="1" isodate="2026-11-10">
            <respStmt xml:id="respStmt-1">
               <persName xml:id="persName-1">ohwjdev</persName>
            </respStmt>
            <changeDesc xml:id="changeDesc-1">
               <p xml:id="p-1">Score generated by Let's Encode!</p>
            </changeDesc>
         </change>
      </revisionDesc>
   </meiHead>
   <music xml:id="music-1">
      <body xml:id="body-1">
         <mdiv xml:id="mdiv-1" n="1">
            <score xml:id="score-1">
               <scoreDef xml:id="scoreDef-1">
                  <staffGrp xml:id="staffGrp-1">
                     <staffDef xml:id="staffDef-1" n="1" lines="5" clef.shape="G" clef.line="2" meter.count="4" meter.unit="4"/>
                  </staffGrp>
               </scoreDef>
               <section xml:id="section-1">
               <measure xml:id="measure-1" n="1">
                  <staff xml:id="staff-1" n="1">
                     <layer xml:id="layer-1" n="1">
                        <mRest xml:id="mRest-1"/>
                     </layer>
                  </staff>
               </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>